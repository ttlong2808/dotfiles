{
  "name": "dotman",
  "version": "1.0.0",
  "description": "Dotfile Manager for Hyprland",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:react": "tsc && vite build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build": "npm run build:react && npm run build:electron",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --linux deb"
  },
  "keywords": [
    "hyprland",
    "dotfiles",
    "manager"
  ],
  "author": "DotMan Team",
  "license": "ISC",
  "build": {
    "appId": "com.antigravity.dotman",
    "productName": "DotMan",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "deb": {
      "priority": "optional",
      "depends": [
        "libnss3",
        "libatk1.0-0",
        "libatk-bridge2.0-0",
        "libcups2",
        "libdrm2",
        "libgtk-3-0",
        "libgbm1",
        "libasound2"
      ]
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
